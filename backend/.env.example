# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=False

# Security Settings (use strong, randomly generated keys in production)
SECRET_KEY=change-this-in-production-to-random-string
JWT_SECRET_KEY=change-this-in-production-to-random-string

# CORS Settings (comma-separated list, use specific domains in production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATELIMIT_STORAGE_URL=memory://
